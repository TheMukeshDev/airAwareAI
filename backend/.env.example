FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

SUPABASE_DB_URL=
DB_BACKEND=postgres

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45


OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

CARTO_API_KEY=
CARTO_TILE_TIMEOUT_SECONDS=6
CARTO_TILE_MAX_BYTES=1048576
CARTO_TILE_CACHE_SECONDS=86400

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=600
MAX_FETCH_LIMIT=5000

RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
SHARED_RATE_LIMIT_ENABLED=true
MAX_CONTENT_LENGTH=1048576
SECURITY_HEADERS_ENABLED=true

# Production: run with `waitress-serve --host=127.0.0.1 --port=5000 --call app:create_app`
# Never enable FLASK_DEBUG outside local development.
