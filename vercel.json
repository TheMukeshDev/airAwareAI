{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "framework": "flask",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py,.venv/**,__pycache__/**,*.pyc}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
